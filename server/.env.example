# Server
PORT=5001
NODE_ENV=development

# PostgreSQL connection string used by Prisma
DATABASE_URL=postgresql://ryze:ryze@localhost:5432/ryze

# Auth secrets
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# OAuth session secret for the google callback flow
OAUTH_STATE_SECRET=change-me-oauth-secret

# CORS origins allowed in dev (comma separated)
CLIENT_ORIGIN=http://localhost:5173

# Google OAuth — placeholders. Fill these in Google Cloud Console and the
# callback (GOOGLE_REDIRECT_URI) to enable "Continue with Google".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5001/api/auth/google/callback

# AI team integration — leave blank to serve mock responses.
AI_BASE_URL=
AI_SERVICE_KEY=

# Self-hosted RAG knowledge assistant. AI_PROVIDER = auto | openai | gemini.
# Set AI_API_KEY (e.g. an OpenAI or Gemini key) to enable live LLM answers.
# Without it the assistant answers from the knowledge base with mock text.
AI_PROVIDER=auto
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Local uploads
UPLOAD_DIR=./uploads
