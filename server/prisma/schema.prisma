// RYZE — Prisma schema
// PostgreSQL database. All models are owned and hosted by us (no BaaS).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  student
  mentor
  admin
}

enum OAuthProvider {
  google
}

enum ChallengeDifficulty {
  easy
  medium
  hard
}

enum ChatType {
  dm
  channel
}

enum NotificationType {
  like
  comment
  mention
  challenge
  startup
  interest
  system
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  passwordHash   String?
  name           String
  role           Role            @default(student)
  avatarUrl      String?
  oauthProvider  OAuthProvider?
  oauthId        String?
  isVerified     Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  profile             Profile?
  posts               Post[]
  postLikes           PostLike[]
  comments            Comment[]
  notes               Note[]
  interviewExperiences InterviewExperience[]
  challengeSubmissions ChallengeSubmission[]
  streaks             Streak[]
  startupsOwned       Startup[]
  teamMemberships     TeamMember[]
  chats               ChatMember[]
  messages            Message[]
  notifications       Notification[]
  learningEvents      LearningEvent[]
  aiReports           AIReport[]
  cofounderMatches    CoFounderMatch[]
  applications        JobApplication[]
  refreshSessions     RefreshSession[]

  @@index([email])
  @@index([role])
}

model RefreshSession {
  id        String    @id
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  bio         String?
  branch      String?
  year        Int?
  college     String?
  skills      String[] @default([])
  resumeUrl   String?
  githubUrl   String?
  linkedinUrl String?
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Post {
  id        String   @id @default(cuid())
  authorId  String
  content   String   @db.Text
  tags      String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes     PostLike[]
  comments  Comment[]

  @@index([authorId])
  @@index([createdAt])
}

model PostLike {
  id     String @id @default(cuid())
  postId String
  userId String

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  content   String   @db.Text
  createdAt DateTime @default(now())

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([authorId])
}

model Note {
  id            String   @id @default(cuid())
  authorId      String
  title         String
  description   String?  @db.Text
  fileUrl       String?
  tags          String[] @default([])
  downloadCount Int      @default(0)
  createdAt     DateTime @default(now())

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([createdAt])
}

model Company {
  id         String   @id @default(cuid())
  name       String   @unique
  website    String?
  logoUrl    String?
  about      String?  @db.Text
  hqLocation String?
  createdAt  DateTime @default(now())

  jobs                  Job[]
  pyqs                  Pyq[]
  interviewExperiences  InterviewExperience[]
  roadmaps              Roadmap[]

  @@index([name])
}

model Job {
  id            String   @id @default(cuid())
  companyId     String
  title         String
  location      String?
  type          String
  eligibility   String?
  salaryRange   String?
  applyUrl      String?
  postedAt      DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications JobApplication[]

  @@index([companyId])
  @@index([postedAt])
}

model JobApplication {
  id        String   @id @default(cuid())
  jobId     String
  userId    String
  status    String   @default("applied")
  createdAt DateTime @default(now())

  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([jobId, userId])
  @@index([userId])
}

model Pyq {
  id         String   @id @default(cuid())
  companyId  String
  title      String
  round      String?
  difficulty String
  content    String?  @db.Text
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model InterviewExperience {
  id        String   @id @default(cuid())
  companyId String
  authorId  String
  role      String
  summary   String   @db.Text
  content   String   @db.Text
  rating    Int?
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([authorId])
}

model Roadmap {
  id          String   @id @default(cuid())
  companyId   String
  title       String
  description String   @db.Text
  steps       String[] @default([])
  createdAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Challenge {
  id          String              @id @default(cuid())
  title       String
  description String              @db.Text
  difficulty  ChallengeDifficulty @default(easy)
  tags        String[]            @default([])
  points      Int                 @default(10)
  date        DateTime
  createdBy   String
  createdAt   DateTime            @default(now())

  submissions ChallengeSubmission[]

  @@index([date])
  @@index([difficulty])
}

model ChallengeSubmission {
  id          String   @id @default(cuid())
  challengeId String
  userId      String
  code        String   @db.Text
  language    String   @default("javascript")
  status      String   @default("submitted")
  createdAt   DateTime @default(now())

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@index([userId])
  @@index([createdAt])
}

model Streak {
  id         String   @id @default(cuid())
  userId     String   @unique
  current    Int      @default(0)
  longest    Int      @default(0)
  lastActive DateTime?
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Startup {
  id             String   @id @default(cuid())
  ownerId        String
  name           String
  tagline        String
  description    String   @db.Text
  lookingFor     String[] @default([])
  stage          String   @default("idea")
  membersNeeded  Int      @default(1)
  createdAt      DateTime @default(now())

  owner   User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  teams   StartupTeam[]
  matches CoFounderMatch[]

  @@index([ownerId])
  @@index([createdAt])
}

model StartupTeam {
  id        String       @id @default(cuid())
  startupId String
  name      String
  createdAt DateTime     @default(now())

  startup Startup      @relation(fields: [startupId], references: [id], onDelete: Cascade)
  members TeamMember[]

  @@index([startupId])
}

model TeamMember {
  id     String   @id @default(cuid())
  teamId String
  userId String
  role   String   @default("member")
  joinedAt DateTime @default(now())

  team StartupTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

model CoFounderMatch {
  id        String   @id @default(cuid())
  userId    String
  startupId String
  status    String   @default("interested")
  message   String?
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startup Startup  @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@unique([userId, startupId])
  @@index([startupId])
}

model Chat {
  id            String    @id @default(cuid())
  type          ChatType  @default(dm)
  name          String?
  createdAt     DateTime  @default(now())
  lastMessageAt DateTime?

  members  ChatMember[]
  messages Message[]

  @@index([type])
}

model ChatMember {
  id     String @id @default(cuid())
  chatId String
  userId String
  joinedAt DateTime @default(now())

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
  @@index([userId])
}

model Message {
  id        String   @id @default(cuid())
  chatId    String
  senderId  String
  content   String   @db.Text
  readAt    DateTime?
  createdAt DateTime @default(now())

  chat   Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
  @@index([senderId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType @default(system)
  title     String
  body      String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
}

// Behavior/activity log consumed by the AI team's models.
model LearningEvent {
  id        String   @id @default(cuid())
  userId    String
  type      String
  payload   Json
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([type])
}

// Outputs written back by the AI service via our API.
model AIReport {
  id            String   @id @default(cuid())
  userId        String
  periodStart   DateTime
  periodEnd     DateTime
  summary       String   @db.Text
  learningScore Int
  strengths     String[] @default([])
  improvements  String[] @default([])
  recommendations String[] @default([])
  generatedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, generatedAt])
}
