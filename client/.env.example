# API base URL. Leave as /api in dev to use the Vite proxy, or set an absolute
# URL in production when the client is served separately.
VITE_API_URL=/api

# WebSocket base URL.
VITE_WS_URL=/ws

# Set to "true" to route AI calls to the real proxy (/api/ai/*). When false
# (default) the app uses the built-in mock adapter, so all AI UI works today.
VITE_AI_ENABLED=false
