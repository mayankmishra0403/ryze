# Copy this file to `deploy/.env` and fill in real values on the VPS.

# Postgres
POSTGRES_USER=ryze
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=ryze

# JWT secrets — generate strong random values
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
OAUTH_STATE_SECRET=change-me-oauth-secret

# Public origin of the app (used for OAuth redirects + CORS)
CLIENT_ORIGIN=http://localhost

# Google OAuth — fill to enable "Continue with Google"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/api/auth/google/callback

# AI team integration — leave blank to serve mock responses
AI_BASE_URL=
AI_SERVICE_KEY=

# Self-hosted RAG knowledge assistant (server-side RAG + LLM).
# AI_PROVIDER = auto | openai | gemini. Set AI_API_KEY (OpenAI or Gemini key)
# to enable live LLM answers; without it the assistant answers from the
# knowledge base with mock text.
AI_PROVIDER=auto
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Uploads
UPLOAD_DIR=/app/uploads
